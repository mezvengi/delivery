# Environment mode
NODE_ENV=production
PORT=3000

# Public domain and Caddy configuration
DOMAIN=sour.serveirc.com
ACME_EMAIL=admin@sour.serveirc.com

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=sour_admin
DB_PASSWORD=your_db_password_here
DB_NAME=sour_delivery

# Security / Authentication
JWT_SECRET=your_jwt_secret_here

# Sour El Ghozlane Delivery Settings
DEFAULT_ZONE_ID=sour_el_ghozlane
CENTER_LAT=36.148
CENTER_LNG=3.690
GEOFENCE_RADIUS_KM=8.0
CURRENCY=DA
FIXED_DELIVERY_FEE=200

# OTP & Messaging Settings
# Set to 'mock' for local dev logs, or 'telegram'
OTP_CHANNEL=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Initial Admin Account
ADMIN_PHONE=+213555000000
ADMIN_PASSWORD=change_this_admin_password
